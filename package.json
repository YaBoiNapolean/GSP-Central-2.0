{
  "name": "gsp-central",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "python": ">=3.9"
  },
  "scripts": {
    "install:api": "npm --prefix cad-system/api ci",
    "install:dashboard": "npm --prefix cad-system/dashboard ci",
    "setup": "npm run install:api && npm run install:dashboard",
    "dev:api": "npm --prefix cad-system/api run dev",
    "dev:dashboard": "npm --prefix cad-system/dashboard run dev",
    "build": "npm --prefix cad-system/dashboard run build",
    "lint": "npm --prefix cad-system/dashboard run lint",
    "start:api": "npm --prefix cad-system/api start",
    "start:bot": "python3 main.py"
  }
}
